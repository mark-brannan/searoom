{
  "name": "searoom",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "See the rules of the road — interactive COLREGS navigation-lights study tool",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-rule-images.mjs",
    "build": "tsc -b && vite build",
    "predev": "node scripts/copy-rule-images.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "goldens": "node scripts/goldens.mjs check",
    "goldens:update": "node scripts/goldens.mjs update",
    "review-pack": "node scripts/fi-review-pack.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "colregs": "github:mark-brannan/colregs#main",
    "colregs-engine": "github:mark-brannan/colregs-engine#main",
    "nav-wright": "github:mark-brannan/nav-wright#main",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-intl": "^10.2.2",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.1"
  }
}
